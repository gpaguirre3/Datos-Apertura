# DOMINIO se define en config/produccion.env
{$DOMINIO} {
	encode gzip

	# La API, sin el prefijo: el backend sigue viendo /api/...
	handle /Apertura/api/* {
		uri strip_prefix /Apertura
		reverse_proxy backend:4200
	}

	# Visor de la pantalla del servidor, solo con sesión abierta en la app
	handle_path /Apertura/pantalla/* {
		forward_auth backend:4200 {
			uri /api/auth/me
			copy_headers Cookie
		}
		reverse_proxy backend:6080
	}

	# La interfaz
	handle_path /Apertura/* {
		reverse_proxy frontend:80
	}

	# Entrar sin barra final también funciona
	redir /Apertura /Apertura/ permanent
}
