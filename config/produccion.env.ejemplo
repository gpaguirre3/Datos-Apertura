# Copia este archivo a config/produccion.env y rellena los valores.
# NO lo subas a ningún repositorio: lleva contraseñas.

# --- Dirección de la app ---
# Dominio público (Caddy saca el certificado solo):  DOMINIO=datos.tudominio.com
# Solo red interna, sin certificado:                 DOMINIO=http://192.168.1.50
# El prefijo http:// es lo que evita que intente pedir un certificado.
DOMINIO=datos.tudominio.com

# --- Base de datos (el contenedor la crea con estos datos) ---
MYSQL_DATABASE=sacardatos
MYSQL_USER=sacardatos
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-clave-de-root

# --- Los mismos datos, como los lee la app ---
DB_HOST=db
DB_PORT=3306
DB_NAME=sacardatos
DB_USER=sacardatos
DB_PASSWORD=cambia-esta-clave

# --- Sesión ---
SESION_MINUTOS=300

# --- Portal de Mina ---
MINA_USUARIO=
MINA_CLAVE=
MINA_AUTORIZADO=si

# --- Páginas que se consultan ---
ISSPOL_URL="https://siisspolweb.isspol.org.ec/#/publico/reporteAfiliacionExterno"
ISSFA_URL=https://ias.issfa.mil.ec/certificados/Formulario.jsf
SUPA_URL=https://supa.funcionjudicial.gob.ec/pensiones/publico/consulta.jsf
JUDICIAL_URL=https://procesosjudiciales.funcionjudicial.gob.ec/busqueda-filtros
ADUANA_URL=https://www.aduana.gob.ec/consultacupos/
MINA_URL=http://186.4.213.167/Mina/

# --- Pantalla remota (captcha de Procesos judiciales) ---
PANTALLA_TAMANO=1920x1080x24

# --- Contraseña de la pantalla remota ---
# Protege el visor del captcha. Máximo 8 caracteres: es un límite del propio VNC.
VISOR_CLAVE=

# --- Procesos judiciales ---
# Segundos entre una búsqueda y la siguiente. Subirlo reduce los retos de imágenes difíciles.
JUDICIAL_PAUSA=15
