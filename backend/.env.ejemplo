# Copia este archivo a backend/.env para desarrollo local.
# En producción no se usa: ahí manda config/produccion.env.

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sacardatos
DB_USER=sacardatos
DB_PASSWORD=

# --- Sesión ---
SESION_MINUTOS=300

# --- Portal de Mina ---
MINA_USUARIO=
MINA_CLAVE=
MINA_AUTORIZADO=si

# --- Páginas que se consultan ---
ISSPOL_URL="https://siisspolweb.isspol.org.ec/#/publico/reporteAfiliacionExterno"
ISSFA_URL=https://ias.issfa.mil.ec/certificados/Formulario.jsf
SUPA_URL=https://supa.funcionjudicial.gob.ec/pensiones/publico/consulta.jsf
JUDICIAL_URL=https://procesosjudiciales.funcionjudicial.gob.ec/busqueda-filtros
ADUANA_URL=https://www.aduana.gob.ec/consultacupos/
MINA_URL=

# --- Opcional: salir por un proxy ---
# ISSPOL_PROXY=http://usuario:clave@host:puerto
